SDL backend: optional client latency measurement (network receive -> present)

When MOONLIGHT_LATENCY_DEBUG=1, the SDL backend records the receive time of
each frame's first packet (DECODE_UNIT.receiveTimeMs, in LiGetMillis()
milliseconds) and prints a line every 60 presented frames:

  client latency recv->present: avg X min Y max Z (60 frames)

This is the client half of end-to-end latency (network receive to
SDL_RenderPresent, which swaps the frame in and returns once vsync has
passed) and the A/B metric for SDL_BUFFER_FRAMES 2 vs 1 on device. It is off
by default and adds no work to the frame path unless the variable is exactly
"1".

Producer and reporter run on different threads (the decoder thread fills the
ring, the SDL thread reports). A batch is claimed by advancing the index past
it with an atomic store, never by resetting a shared counter from the
diff --git a/src/sdl.c b/src/sdl.c
index 25567de..9536a6f 100644
--- a/src/sdl.c
+++ b/src/sdl.c
@@ -24,6 +24,8 @@
 
 #include <Limelight.h>
 
+#include <inttypes.h>
+
 static bool done;
 static int fullscreen_flags;
 
@@ -35,9 +37,57 @@ SDL_mutex *mutex;
 
 int sdlCurrentFrame, sdlNextFrame;
 
+bool sdlLatencyDebug;
+uint64_t sdlLatencyReceiveMs[SDL_LATENCY_SAMPLES];
+int sdlLatencyCount;
+
+/*
+ * Client-side latency, measured per frame: every present takes the current
+ * time and subtracts the receive time of the frame it is showing, and the
+ * sample goes into a small ring. The report only aggregates the samples it
+ * collected; it never rescales or clears anything shared with the decoder
+ * thread, so a frame is always measured against its own receive time.
+ */
+static uint32_t latency_ring[SDL_LATENCY_SAMPLES];
+static int latency_ring_count;
+
+void sdl_latency_frame(uint64_t receive_ms) {
+  if (!sdlLatencyDebug)
+    return;
+
+  uint64_t now = LiGetMillis();
+  uint64_t latency = now > receive_ms ? now - receive_ms : 0;
+
+  latency_ring[latency_ring_count % SDL_LATENCY_SAMPLES] = (uint32_t)(latency > UINT32_MAX ? UINT32_MAX : latency);
+  latency_ring_count++;
+
+  if (latency_ring_count % SDL_LATENCY_SAMPLES == 0) {
+    static uint32_t sorted[SDL_LATENCY_SAMPLES];
+    int i, j;
+    uint64_t sum = 0;
+
+    for (i = 0; i < SDL_LATENCY_SAMPLES; i++) {
+      uint32_t v = latency_ring[i];
+      for (j = i; j > 0 && sorted[j - 1] > v; j--)
+        sorted[j] = sorted[j - 1];
+      sorted[j] = v;
+      sum += v;
+    }
+    printf("client latency recv->present: avg %" PRIu64 " min %u p50 %u p95 %u max %u (%d frames)\n",
+           sum / SDL_LATENCY_SAMPLES, sorted[0],
+           sorted[SDL_LATENCY_SAMPLES / 2],
+           sorted[(SDL_LATENCY_SAMPLES * 95) / 100],
+           sorted[SDL_LATENCY_SAMPLES - 1], SDL_LATENCY_SAMPLES);
+    fflush(stdout);
+  }
+}
+
 void sdl_init(int width, int height, bool fullscreen) {
   sdlCurrentFrame = sdlNextFrame = 0;
 
+  const char* latencyDebug = getenv("MOONLIGHT_LATENCY_DEBUG");
+  sdlLatencyDebug = latencyDebug != NULL && latencyDebug[0] == '1' && latencyDebug[1] == '\0';
+
   if(SDL_Init(SDL_INIT_VIDEO | SDL_INIT_EVENTS)) {
     fprintf(stderr, "Could not initialize SDL - %s\n", SDL_GetError());
     exit(1);
@@ -106,6 +156,7 @@ void sdl_loop() {
             SDL_RenderClear(renderer);
             SDL_RenderCopy(renderer, bmp, NULL, NULL);
             SDL_RenderPresent(renderer);
+            sdl_latency_frame(*((uint64_t*) event.user.data2));
           } else
