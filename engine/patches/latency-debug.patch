SDL backend: optional client latency measurement (network receive -> present)

When MOONLIGHT_LATENCY_DEBUG=1, the SDL backend measures each presented frame
at the moment it presents it: present time (LiGetMillis) minus that frame's
own receive time (DECODE_UNIT.receiveTimeMs in the engine's common-c;
receiveTimeUs / 1000 in newer ones), handed over by sdl_latency_receive()
just before the frame event is pushed. Every 60 frames it aggregates the
samples it collected:

  client latency recv->present: avg X min A p50 B p95 C max D (60 frames)

This is the client half of end-to-end latency (network receive to
SDL_RenderPresent, which swaps the frame in and returns once vsync has
passed) and the A/B metric for SDL_BUFFER_FRAMES 2 vs 1 on device. It is off
by default and adds no work to the frame path unless the variable is exactly
"1".

The frame event keeps its payload: data1 is the plane pointers and data2
their linesizes, which is what sdl_loop() passes to SDL_UpdateYUVTexture. The
receive time travels separately through one atomic word, so no decoder has to
change the event to be measured, and a present can never read a stride out of
a timestamp. The hardware decoder in src/video/sdl.c (see
sdl-cedar-hwdec.patch) calls the same hook.

The measurement happens on the SDL thread only: an earlier version compared a
present time against timestamps collected in a window of up to a second, with
a counter reset in between, and reported the window span (~500 ms) instead of
the latency. Nothing is reset now; every present measures its own frame.

diff --git a/src/sdl.c b/src/sdl.c
index 25567de..8dc4086 100644
--- a/src/sdl.c
+++ b/src/sdl.c
@@ -24,6 +24,9 @@
 
 #include <Limelight.h>
 
+#include <inttypes.h>
+#include <stdatomic.h>
+
 static bool done;
 static int fullscreen_flags;
 
@@ -35,9 +38,70 @@ SDL_mutex *mutex;
 
 int sdlCurrentFrame, sdlNextFrame;
 
+bool sdlLatencyDebug;
+uint64_t sdlLatencyReceiveMs;
+int sdlLatencyCount;
+
+/*
+ * Client-side latency, measured per frame: every present takes the current
+ * time and subtracts the receive time of the frame it is showing, and the
+ * sample goes into a small ring. The report only aggregates the samples it
+ * collected; it never rescales or clears anything shared with the decoder
+ * thread, so a frame is always measured against its own receive time.
+ *
+ * The receive time travels on its own: the frame event's data1/data2 keep
+ * carrying the planes and their linesizes, which is what sdl_loop() reads.
+ */
+static _Atomic uint64_t latency_receive_ms;
+static uint32_t latency_ring[SDL_LATENCY_SAMPLES];
+static int latency_ring_count;
+
+void sdl_latency_receive(uint64_t receive_ms) {
+  if (!sdlLatencyDebug)
+    return;
+  atomic_store_explicit(&latency_receive_ms, receive_ms, memory_order_relaxed);
+}
+
+static void sdl_latency_presented(void) {
+  static uint32_t sorted[SDL_LATENCY_SAMPLES];
+  uint64_t now, receive, latency, sum = 0;
+  uint32_t sample;
+  int i, j;
+
+  if (!sdlLatencyDebug)
+    return;
+
+  now = LiGetMillis();
+  receive = atomic_load_explicit(&latency_receive_ms, memory_order_relaxed);
+  latency = now > receive ? now - receive : 0;
+  sample = (uint32_t)(latency > UINT32_MAX ? UINT32_MAX : latency);
+
+  latency_ring[latency_ring_count % SDL_LATENCY_SAMPLES] = sample;
+  latency_ring_count++;
+  if (latency_ring_count % SDL_LATENCY_SAMPLES != 0)
+    return;
+
+  for (i = 0; i < SDL_LATENCY_SAMPLES; i++) {
+    uint32_t v = latency_ring[i];
+    for (j = i; j > 0 && sorted[j - 1] > v; j--)
+      sorted[j] = sorted[j - 1];
+    sorted[j] = v;
+    sum += v;
+  }
+  printf("client latency recv->present: avg %" PRIu64 " min %u p50 %u p95 %u max %u (%d frames)\n",
+         sum / SDL_LATENCY_SAMPLES, sorted[0],
+         sorted[SDL_LATENCY_SAMPLES / 2],
+         sorted[(SDL_LATENCY_SAMPLES * 95) / 100],
+         sorted[SDL_LATENCY_SAMPLES - 1], SDL_LATENCY_SAMPLES);
+  fflush(stdout);
+}
+
 void sdl_init(int width, int height, bool fullscreen) {
   sdlCurrentFrame = sdlNextFrame = 0;
 
+  const char* latencyDebug = getenv("MOONLIGHT_LATENCY_DEBUG");
+  sdlLatencyDebug = latencyDebug != NULL && latencyDebug[0] == '1' && latencyDebug[1] == '\0';
+
   if(SDL_Init(SDL_INIT_VIDEO | SDL_INIT_EVENTS)) {
     fprintf(stderr, "Could not initialize SDL - %s\n", SDL_GetError());
     exit(1);
@@ -106,6 +170,7 @@ void sdl_loop() {
             SDL_RenderClear(renderer);
             SDL_RenderCopy(renderer, bmp, NULL, NULL);
             SDL_RenderPresent(renderer);
+            sdl_latency_presented();
           } else
             fprintf(stderr, "Couldn't lock mutex\n");
         }
