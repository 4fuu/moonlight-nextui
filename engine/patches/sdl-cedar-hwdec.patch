+  static unsigned char* cedar_planes[3];
+  static int cedar_linesize[3];
+
+  if (hwdec) {
+    int status = cedar_sdl_submit(decodeUnit);
+
+    if (cedar_sdl_frame(cedar_planes, cedar_linesize)) {
+      sdlNextFrame++;
+
+      SDL_Event event;
+      event.type = SDL_USEREVENT;
+      event.user.code = SDL_CODE_FRAME;
+      event.user.data1 = cedar_planes;
+      event.user.data2 = cedar_linesize;
+      SDL_PushEvent(&event);
