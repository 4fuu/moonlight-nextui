+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef MOONLIGHT_TSP_CEDAR_H
+#define MOONLIGHT_TSP_CEDAR_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "cedarc_abi.h"
+
+struct cedar_config {
+    int codec;          /* CEDAR_CODEC_H264 or CEDAR_CODEC_H265 */
+    int width;
+    int height;
+    int fps;
+    int pixel_format;   /* CEDAR_PIXEL_NV12 or CEDAR_PIXEL_NV21 */
+    int rotate;         /* raw nRotateDegree index, 0 disables rotation */
+    int display_hold;   /* pictures the display may keep */
+    int smooth;         /* extra decoder pictures */
+    int vbv_bytes;      /* compressed stream buffer */
+};
+
+struct cedar_segment {
+    const void *data;
+    size_t len;
+};
+
+struct cedar_decoder;
+
+/* Loads the vendor libraries and registers only the H.264/H.265 plugins. */
+int cedar_load(char *err, size_t errlen);
+
+/* 1 if the plugin for codec (CEDAR_CODEC_*) was found and registered. */
+int cedar_has_codec(int codec);
+
+struct cedar_decoder *cedar_open(const struct cedar_config *cfg, char *err,
+                                 size_t errlen);
+void cedar_close(struct cedar_decoder *dec);
+
+/* Copies one complete access unit into the decoder's stream buffer. */
+int cedar_submit(struct cedar_decoder *dec, const struct cedar_segment *seg,
+                 int count, int64_t pts);
+
+/* Runs the engine; returns a CEDAR_RESULT_* code. */
+int cedar_decode(struct cedar_decoder *dec);
+
+CedarVideoPicture *cedar_request_picture(struct cedar_decoder *dec);
+int cedar_return_picture(struct cedar_decoder *dec, CedarVideoPicture *pic);
+int cedar_valid_pictures(struct cedar_decoder *dec);
+int cedar_stream_frames(struct cedar_decoder *dec);
+void cedar_reset(struct cedar_decoder *dec);
+
+const char *cedar_result_name(int result);
+
+#endif
diff --git a/src/cedar/cedar_sync.c b/src/cedar/cedar_sync.c
new file mode 100644
index 0000000..9c6e2ac
--- /dev/null
+++ b/src/cedar/cedar_sync.c
@@ -0,0 +1,152 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include "cedar_sync.h"
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <linux/futex.h>
+#include <pthread.h>
+#include <semaphore.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <unistd.h>
+
+typedef int (*semtimedwait_fn)(sem_t *sem, int64_t time_ms);
+
+static _Atomic unsigned idle_seq;
+static _Atomic unsigned waiters;
+static _Atomic unsigned long n_calls, n_blocked, n_timeouts;
+
+static pthread_once_t mode_once = PTHREAD_ONCE_INIT;
+static semtimedwait_fn vendor_fn;
+
+static void pick_mode(void)
+{
+    const char *mode = getenv("TSP_SEMWAIT");
+    void *h;
+
+    if (mode == NULL || strcmp(mode, "vendor") != 0)
+        return;
+    h = dlopen("libcdc_base.so", RTLD_NOW | RTLD_NOLOAD);
+    if (h == NULL)
+        return;
+    /* A handle lookup starts at libcdc_base itself, not at us. */
+    vendor_fn = (semtimedwait_fn)dlsym(h, "SemTimedWait");
+    dlclose(h);
+}
+
+static void announce_block(void)
+{
+    /* Sequentially consistent: pairs with the waiter's waiters++/load. */
+    atomic_fetch_add(&idle_seq, 1);
+    if (atomic_load(&waiters) != 0)
+        syscall(SYS_futex, &idle_seq, FUTEX_WAKE_PRIVATE, INT_MAX, NULL,
+                NULL, 0);
+}
+
+/*
+ * Same contract as the vendor function: wait up to time_ms milliseconds
+ * (-1 = forever) and return 0 if the semaphore was taken, -1 otherwise.
+ */
+/*
+ * Local port: the tg5040 toolchain's ld.bfd 2.31 has no
+ * --export-dynamic-symbol (binutils 2.35+), so the build also links this
+ * binary with -rdynamic and libcdc_base binds to it anyway; the symbol is
+ * visible by default either way.
+ */
+__attribute__((visibility("default"))) int SemTimedWait(sem_t *sem,
+                                                         int64_t time_ms)
+{
+    struct timespec ts;
+    int r;
+
+    pthread_once(&mode_once, pick_mode);
+    if (vendor_fn != NULL)
+        return vendor_fn(sem, time_ms);
+
+    atomic_fetch_add_explicit(&n_calls, 1, memory_order_relaxed);
+    if (sem_trywait(sem) == 0)
+        return 0;
+    if (errno != EAGAIN)
+        return -1;
+    if (time_ms < -1 || time_ms == 0)
+        return -1;
+
+    atomic_fetch_add_explicit(&n_blocked, 1, memory_order_relaxed);
+    announce_block();
+
+    if (time_ms == -1) {
+        do
+            r = sem_wait(sem);
+        while (r != 0 && errno == EINTR);
+        return r == 0 ? 0 : -1;
+    }
+
+    /*
+     * Local port: the tg5040 toolchain sysroot is glibc 2.28 and has no
+     * sem_clockwait (2.30+), so the absolute timeout is CLOCK_REALTIME.
+     * The vendor contract is milliseconds, so a clock step matters no more
+     * than it does for the vendor implementation.
+     */
+    clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_sec += (time_t)(time_ms / 1000);
+    ts.tv_nsec += (long)(time_ms % 1000) * 1000000L;
+    if (ts.tv_nsec >= 1000000000L) {
+        ts.tv_sec++;
+        ts.tv_nsec -= 1000000000L;
+    }
+    do
+        r = sem_timedwait(sem, &ts);
+    while (r != 0 && errno == EINTR);
+    if (r != 0) {
+        atomic_fetch_add_explicit(&n_timeouts, 1, memory_order_relaxed);
+        return -1;
+    }
+    return 0;
+}
+
+unsigned cedar_sync_seq(void)
+{
+    return atomic_load(&idle_seq);
+}
+
+int cedar_sync_wait(unsigned seq, uint64_t deadline_ns)
+{
+    int changed = 0;
+
+    atomic_fetch_add(&waiters, 1);
+    for (;;) {
+        struct timespec now, rel;
+        uint64_t now_ns;
+
+        if (atomic_load(&idle_seq) != seq) {
+            changed = 1;
+            break;
+        }
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        now_ns = (uint64_t)now.tv_sec * 1000000000ull + (uint64_t)now.tv_nsec;
+        if (now_ns >= deadline_ns)
+            break;
+        rel.tv_sec = (time_t)((deadline_ns - now_ns) / 1000000000ull);
+        rel.tv_nsec = (long)((deadline_ns - now_ns) % 1000000000ull);
+        /* Returns at once if idle_seq already moved past seq. */
+        syscall(SYS_futex, &idle_seq, FUTEX_WAIT_PRIVATE, seq, &rel, NULL, 0);
+    }
+    atomic_fetch_sub(&waiters, 1);
+    return changed;
+}
+
+void cedar_sync_stats(struct cedar_sync_stats *out)
+{
+    pthread_once(&mode_once, pick_mode);
+    out->calls = atomic_load(&n_calls);
+    out->blocked = atomic_load(&n_blocked);
+    out->timeouts = atomic_load(&n_timeouts);
+    out->vendor = vendor_fn != NULL;
+}
diff --git a/src/cedar/cedar_sync.h b/src/cedar/cedar_sync.h
new file mode 100644
index 0000000..e6c9cf8
--- /dev/null
+++ b/src/cedar/cedar_sync.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef MOONLIGHT_TSP_CEDAR_SYNC_H
+#define MOONLIGHT_TSP_CEDAR_SYNC_H
+
+#include <stdint.h>
+
+/*
+ * Blocking replacement for libcdc_base's exported SemTimedWait().
+ *
+ * The vendor version polls sem_trywait() with an exponential usleep()
+ * backoff (10 us doubling up to the timeout), so the SBM parser thread
+ * notices a newly submitted frame only at its next poll, often several ms
+ * later, and wakes hundreds of times per second while idle. The executable
+ * exports its own SemTimedWait (linked with
+ * -Wl,--export-dynamic-symbol=SemTimedWait), which the dynamic linker binds
+ * libsbm.so's and libcdc_base.so's PLT calls to.
+ *
+ * Every time a vendor thread is about to block, a sequence number advances.
+ * For the SBM parser that happens once it has consumed all submitted data,
+ * so a decoder thread can sleep until then instead of polling.
+ *
+ * Set TSP_SEMWAIT=vendor in the environment to forward to the vendor
+ * implementation (A/B testing).
+ */
+
+/* Current parser-idle sequence number. Take it before submitting. */
+unsigned cedar_sync_seq(void);
+
+/*
+ * Sleeps until the sequence differs from seq or CLOCK_MONOTONIC reaches
+ * deadline_ns. Returns 1 if the sequence changed, 0 on timeout.
+ */
+int cedar_sync_wait(unsigned seq, uint64_t deadline_ns);
+
+struct cedar_sync_stats {
+    unsigned long calls;    /* SemTimedWait calls that reached us */
+    unsigned long blocked;  /* calls that had to sleep */
+    unsigned long timeouts; /* sleeps that ended without the semaphore */
+    int vendor;             /* 1 if forwarding to the vendor version */
+};
+
+void cedar_sync_stats(struct cedar_sync_stats *out);
+
+#endif
diff --git a/src/cedar/cedarc_abi.h b/src/cedar/cedarc_abi.h
