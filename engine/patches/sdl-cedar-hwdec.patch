+ */
+static bool hwdec;
+
 static int sdl_setup(int videoFormat, int width, int height, int redrawRate, void* context, int drFlags) {
+  const char* value = getenv("MOONLIGHT_HWDEC");
+
+  hwdec = false;
+  if (value != NULL && strcmp(value, "1") == 0) {
+    char err[160];
+
+    if (!cedar_sdl_available())
+      fprintf(stderr, "Cedar decoder unavailable, using FFmpeg\n");
+    else if (cedar_sdl_init(videoFormat, width, height, redrawRate, err, sizeof(err)) == 0) {
+      hwdec = true;
+      return 0;
+    } else
+      fprintf(stderr, "Cedar decoder failed (%s), using FFmpeg\n", err);
+  }
+
   if (ffmpeg_init(videoFormat, width, height, SLICE_THREADING, SDL_BUFFER_FRAMES, SLICES_PER_FRAME) < 0) {
     fprintf(stderr, "Couldn't initialize video decoding\n");
     return -1;
@@ -47,6 +70,11 @@ static int sdl_setup(int videoFormat, int width, int height, int redrawRate, voi
 }
 
 static void sdl_cleanup() {
+  if (hwdec) {
+    cedar_sdl_dump_stats();
+    cedar_sdl_destroy();
+    return;
+  }
   ffmpeg_destroy();
 }
 
